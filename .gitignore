# CMake build trees and downloaded OBS dependencies
/build_*/
/.deps/
/release/

# Local CMake presets (e.g. a different Windows SDK version)
CMakeUserPresets.json

# Exclude lock files
*.lock.json

# Exclude CMake build number cache
/cmake/.CMakeBuildNumber

# Editor / IDE files
/.vs/
/.vscode/
/.idea/

# MSVC debug information
*.pdb

# Installer output
/installer/output/

# macOS resource forks
.DS_Store
